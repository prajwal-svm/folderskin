{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FolderSkin",
  "version": "0.1.5",
  "identifier": "app.folderskin.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:14200",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "FolderSkin",
        "width": 1180,
        "height": 720,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com fscommunity: http://fscommunity.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Give your folders a skin",
    "longDescription": "FolderSkin gives any folder a custom icon: skins from free community packs, your own photos, or art painted by an AI model with your own key. macOS, Windows and Linux.",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["folderskin"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNjE1MzVDRkQ2N0Q5OUYKUldTZjJXZjlYRk5oLzhvbWZyMWVTOHpmZ0xMRXFJMEpRVEFmWWJDQnRPanp2LzJYNHJ4QUdzdkkK",
      "endpoints": [
        "https://github.com/prajwal-svm/folderskin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
